# Connexion PostgreSQL (obligatoire).
# IMPORTANT : incluez le mot de passe et encodez les caractères spéciaux en URL.
# Exemple : postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=<your_postgresql_connection_string>

# Identifiants du premier administrateur (utilisés par `pnpm db:bootstrap`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
